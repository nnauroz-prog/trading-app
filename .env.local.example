# Supabase (server-side persistence + Auth). Lasse alle drei leer, um im
# Mock-Modus ohne Auth-Gate zu laufen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Single-User-Login: nur diese E-Mail-Adresse darf nach Magic-Link-Auth ins
# Dashboard. Andere User werden direkt abgemeldet. Leer = jeder, der den
# Magic Link erhält, kommt rein (für Tests).
ALLOWED_EMAIL=

# Pflicht in Production: schützt /api/cron/daily-report.
# Erzeugen mit z. B. `openssl rand -hex 32`. Im Dev darf der Wert leer sein.
CRON_SECRET=

# WICHTIG für korrekte Sport-/WM-Daten: TheSportsDB Premium API-Key.
# Ohne diesen Key läuft die App auf dem öffentlichen Gratis-TEST-Key "3",
# der stark rate-limitiert ist und oft LEERE oder VERALTETE Daten liefert —
# das ist der Hauptgrund für falsche/fehlende Spielpläne und Ergebnisse.
# Eigenen Key holen: https://www.thesportsdb.com/api.php (~3 USD/Monat via
# Patreon). In Vercel als Env-Var THESPORTSDB_KEY setzen → ALLE Sportarten
# gehen sofort auf echte Live-Daten, ohne Code-Änderung.
THESPORTSDB_KEY=

# Optional: CoinGecko Demo API Key. Ohne Key wird die öffentliche Free-API genutzt.
COINGECKO_API_KEY=

# Aktien-Preise + Company-News-Sentiment via Finnhub. Ohne Key bleiben Aktien
# auf Mock und Sentiment auf dem Default-Wert.
FINNHUB_API_KEY=

# Reserviert für zusätzliche News-Provider.
NEWS_API_KEY=

# Telegram-Push-Alerts für frische Signale (MACD bullish_cross).
# Setup: 1) @BotFather auf Telegram → /newbot → Token notieren.
#        2) Bot anschreiben mit irgendeinem /start.
#        3) https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen → chat.id notieren.
# Beide leer = keine Alerts, Engine läuft trotzdem.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
